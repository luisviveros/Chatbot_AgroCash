# Chatwoot Configuration
CHATWOOT_API_KEY=your_chatwoot_api_key_here
CHATWOOT_BASE_URL=https://app.chatwoot.com

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
BIGQUERY_DATASET=agrocash
BIGQUERY_TABLE=gastos

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Speech-to-Text Configuration (Elige una opción)
STT_PROVIDER=google  # Opciones: "google" o "openai"
OPENAI_API_KEY=your_openai_api_key_here  # Solo si usas OpenAI Whisper

# Dashboard URL
DASHBOARD_URL=https://lookerstudio.google.com/reporting/906bb9db-7a23-480f-8825-09148ceefce6

# Server Configuration
PORT=8000
HOST=0.0.0.0
